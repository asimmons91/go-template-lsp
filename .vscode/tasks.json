{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "mise run build-ts",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "mise run watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    }
  ]
}
