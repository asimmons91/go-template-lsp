{
  "name": "go-template-lsp",
  "displayName": "Go Template Language Support",
  "description": "Type-aware completion for Go templates (via gopls) plus embedded HTML/CSS/JS intellisense",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "go-template-lsp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:gotmpl"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gotmpl",
        "aliases": [
          "Go Template",
          "gotmpl"
        ],
        "extensions": [
          ".gotmpl",
          ".gtpl",
          ".tmpl",
          ".gohtml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gotmpl",
        "scopeName": "text.html.gohtml",
        "path": "./syntaxes/gohtml.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Go Template",
      "properties": {
        "goTemplate.goplsPath": {
          "type": "string",
          "default": "gopls",
          "description": "Path to the gopls binary used for Go-side type checking inside template actions."
        }
      }
    },
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "gotmpl": "html"
      },
      "emmet.showAbbreviationSuggestions": false
    },
    "keybindings": [
      {
        "key": "tab",
        "command": "tab",
        "when": "gotmpl.inAction && config.emmet.triggerExpansionOnTab && editorTextFocus && !editorReadonly && !editorTabMovesFocus"
      }
    ]
  },
  "scripts": {
    "postinstall": "cd client && npm install && cd ../server && npm install",
    "compile": "tsc -p ./client && tsc -p ./server",
    "test": "npm run compile && cd server && npm test",
    "lint": "eslint \"client/src\" \"server/src\"",
    "lint:fix": "eslint --fix \"client/src\" \"server/src\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "watch": "tsc -p ./client -w & tsc -p ./server -w",
    "vscode:prepublish": "npm run compile",
    "package": "node scripts/preflight.mjs && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0"
  }
}
